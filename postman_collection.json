    {
      "name": "1. Core Date Conversion",
      "item": [
        {
          "name": "Gregorian to Ethiopian",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has success true\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "",
                  "pm.test(\"Ethiopian date is valid\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.ethiopian).to.have.property('year');",
                  "    pm.expect(jsonData.data.ethiopian).to.have.property('month');",
                  "    pm.expect(jsonData.data.ethiopian).to.have.property('day');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/conversion/gregorian-to-ethiopian?year=2024&month=1&day=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conversion", "gregorian-to-ethiopian"],
              "query": [
                {
                  "key": "year",
                  "value": "2024"
                },
                {
                  "key": "month",
                  "value": "1"
                },
                {
                  "key": "day",
                  "value": "1"
                }
              ]
            },
            "description": "Convert Gregorian date to Ethiopian calendar date"
          },
          "response": []
        },
